# Variáveis lidas pelo docker-compose.yml na raiz.
# Copie para .env e preencha — NÃO commitar o .env.

# === Domínio público + Let's Encrypt ===
# DNS do DOMAIN deve apontar para o IP público deste servidor antes de rodar init-letsencrypt.sh
DOMAIN=backup.seudominio.com.br
CERTBOT_EMAIL=admin@seudominio.com.br

# === Banco de dados ===
POSTGRES_DB=dbnexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=troque-esta-senha-forte

# === Backend ===
# Chave para assinar os JWT — gere algo longo e aleatório (ex.: openssl rand -hex 64)
SECRET_KEY=troque-por-uma-chave-secreta-longa-aleatoria
# Chave Fernet para criptografar senhas SSH no banco — gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: se trocar essa chave depois, todas as senhas SSH já salvas ficam ilegíveis.
ENCRYPTION_KEY=troque-por-chave-fernet-base64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKUP_RETENTION_DAYS=7
