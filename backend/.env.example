DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5432/nexus_beta
SECRET_KEY=troque-por-uma-chave-secreta-longa-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKUP_RETENTION_DAYS=7
ENCRYPTION_KEY=troque-por-chave-fernet-32-bytes

# Chave Fernet DEDICADA pro arquivo .nxbak (snapshot diário criptografado dos
# backups armazenados — feature v2.0.0). Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazia = export desabilitado. GUARDAR EM LOCAL SEPARADO do servidor — sem ela
# os arquivos .nxbak são irrecuperáveis, nem pela ferramenta externa de leitura.
DB_EXPORT_KEY=
